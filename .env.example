# ==============================================================================
# DFU-Insight Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FASTAPI BACKEND (Set these in Render Web Service Environment)
# ------------------------------------------------------------------------------
# Supabase PostgreSQL Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# JWT Signing Secret (Random 32+ character string)
JWT_SECRET=super-secret-random-key-change-this-in-production

# Model Checkpoint Path (optional)
MODEL_CHECKPOINT_PATH=model/dfu_wagner_net_siam3_best_checkpoint.pt

# ------------------------------------------------------------------------------
# 2. VITE REACT FRONTEND (Set these in Vercel Environment Variables)
# ------------------------------------------------------------------------------
# Backend URL (Leave empty in local dev to use Vite proxy, or set Render URL in Vercel)
# Example: https://dfu-insight-backend.onrender.com
VITE_API_URL=

# Phone.Email Client ID (Free 1,000 SMS/mo OTP service)
# Obtain from https://phone.email -> Admin Dashboard -> Profile
VITE_PHONE_EMAIL_CLIENT_ID=your-phone-email-client-id
